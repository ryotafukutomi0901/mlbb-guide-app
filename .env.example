# AIプロバイダ(いずれか1つ以上。未設定でもサイトは動作し、コーチはサンプル表示になる)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Supabase(未設定の場合はサンプル閲覧モードで動作する)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# quota記録に必須(未設定だと利用量が記録されず上限が機能しない)
SUPABASE_SERVICE_ROLE_KEY=

# サイトURL(canonical / OGP / sitemap の基点)
NEXT_PUBLIC_SITE_URL=

# Stripe(Phase 3後半で使用。価格確定後に設定する)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
